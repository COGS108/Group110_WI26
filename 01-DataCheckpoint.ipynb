    "# Method used to tidy data\n",
    "def find_missing_dates(df):\n",
    "    df['Date'] = pd.to_datetime(df['Date']) \n",
    "    # Sort just in case\n",
    "    df = df.sort_values('Date')\n",
    "    # Create full expected daily range\n",
    "    full_range = pd.date_range(\n",
    "        start=df['Date'].min(),\n",
    "        end=df['Date'].max(),\n",
    "        freq='D'\n",
    "    )\n",
    "    return full_range.difference(df['Date'])\n",
    "\n",
    "## YOUR CODE TO LOAD/CLEAN/TIDY/WRANGLE THE DATA GOES HERE\n",
    "df_btc = pd.read_csv('./data/00-raw/btc-usd.csv')\n",
    "\n",
    "df_btc = df_btc.drop([0, 1]) # csv file previously had multi-index columns. The column\n",
    "                             # names are now entries. This removes them.\n",
    "\n",
    "df_btc = df_btc.rename(columns={ # Rename columns that are useful to us\n",
    "    'Price': 'Date',\n",
    "    'Close': 'BTC_USD Close'\n",
    "}).reset_index(drop=True)\n",
    "\n",
    "#df_btc = df_btc.drop([13, 14]) # Used to test find_missing_dates function\n",
    "\n",
    "missing = find_missing_dates(df_btc) # Test if any dates are missing\n",
    "print(\"Missing dates: \",missing, \"\\n\")\n",
    "\n",
    "print(df_btc.columns) # Used to prove that each column has its own variable\n",
    "\n",
    "df_btc['Date'].is_unique # Used to prove no repeated dates\n",
    "\n",
    "df_btc.info() # Used to prove that each value is a single cell\n",
    "\n",
    "df_btc.describe(include='all') #\n",
    "\n",
    "display(df_btc)"
   ]
